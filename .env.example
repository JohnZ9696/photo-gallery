# server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
APP_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
DATABASE_URL=postgresql://gallery:gallery@localhost:5432/photo_gallery?schema=public

# auth
SESSION_SECRET=local-dev-session-secret-change-me-32chars
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MIN=10

# postgres (docker compose)
POSTGRES_USER=gallery
POSTGRES_PASSWORD=gallery
POSTGRES_DB=photo_gallery

# storage — SeaweedFS S3 gateway
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=photo-gallery
S3_ACCESS_KEY=gallery
S3_SECRET_KEY=gallery-local-secret
S3_FORCE_PATH_STYLE=true

# upload / image
MAX_UPLOAD_FILES=5
MAX_UPLOAD_BYTES=15728640
MAX_PIXELS=50000000
MAX_SIDE=12000
VARIANT_WIDTHS=480,1024,1600
MIN_CROP_SIZE=16
IMAGE_CONCURRENCY=2

# retention
RETENTION_STAGED_MINUTES=60
RETENTION_SUPERSEDED_DAYS=7
RETENTION_DELETED_HOURS=24
RETENTION_ORPHAN_HOURS=24
RETENTION_JOURNAL_HOURS=24
CLEANUP_INTERVAL_MINUTES=15
